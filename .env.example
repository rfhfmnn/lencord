# ==============================================================================
# Lencord P2P Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Rule: Never commit real production secrets or service role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# The canonical Supabase Project URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321 for local)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co

# Public anonymous key for client-side queries and authentication (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Secret service role key for administrative tasks, seed scripts, and webhook processing
# WARNING: Keep this strictly server-side; NEVER expose to client browser bundle.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ------------------------------------------------------------------------------
# Feature Flags & Service Layer
# ------------------------------------------------------------------------------
# Set to 'false' to connect to live Supabase backend, or 'true' to use in-memory mock store
NEXT_PUBLIC_USE_MOCKS=true

# ------------------------------------------------------------------------------
# Banking-as-a-Service (BaaS) Payment Gateway Configuration
# ------------------------------------------------------------------------------
# API base URL for regulated payments processor sandbox/production
BAAS_API_BASE_URL=https://api.sandbox.baas-gateway.ar/v1

# BaaS API credentials
BAAS_API_KEY=test_baas_api_key
BAAS_API_SECRET=test_baas_api_secret

# Shared secret for HMAC-SHA256 signature verification on incoming payment webhooks (/api/webhooks/payments)
BAAS_WEBHOOK_SECRET=test-webhook-secret

# ------------------------------------------------------------------------------
# Cron & Maintenance Endpoints
# ------------------------------------------------------------------------------
# Bearer token secret protecting automated cron jobs (/api/cron/check-deadlines)
CRON_SECRET=test-cron-secret
